<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Queries for Android 11+ SpeechRecognizer -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1. Dibaca / Surah Reader Activity -->
        <activity
            android:name=".SurahActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- 2. Dihafal / Voice Speech Recognition Activity -->
        <activity
            android:name=".HafalanActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- 3. Ditulis / Calligraphy Canvas Activity -->
        <activity
            android:name=".TulisActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- 4. Dipelajari / Tafsir & Hadis Activity -->
        <activity
            android:name=".PelajariActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- 5. Profil Pengguna & Kemajuan Activity -->
        <activity
            android:name=".ProfilActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- 6. Chat & Pelaporan Feedback Activity -->
        <activity
            android:name=".ChatFeedbackActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- FileProvider for Sharing / Viewing Generated Mushaf PDFs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
