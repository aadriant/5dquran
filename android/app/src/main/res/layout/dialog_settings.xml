<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_surah">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Pengaturan Aplikasi"
            android:textColor="@color/gold_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Section 1: Pilihan Qari -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎧 PILIHAN QARI MUROTTAL"
            android:textColor="@color/cyan_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_qari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14152B"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_qari_alafasy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Syaikh Mishari Rashid Alafasy"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_qari_sudais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Syaikh Abdul Rahman As-Sudais"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_qari_ghamdi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Syaikh Saad Al-Ghamdi"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_qari_husary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Syaikh Mahmud Khalil Al-Husary"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_qari_minshawi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Syaikh Muhammad Siddiq Al-Minshawi"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />
        </RadioGroup>

        <!-- Section 2: Pilihan Huruf Mushaf -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📜 PILIHAN HURUF MUSHAF ARAB"
            android:textColor="@color/gold_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_huruf_mushaf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14152B"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_mushaf_madani"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Madani (Uthmani Mushaf Madinah)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_mushaf_naskh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Naskh (Klasik &amp; Jelas)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_mushaf_indopak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Indopak (Khas Asia Selatan / Nastaliq)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />
        </RadioGroup>

        <!-- Section 3: Ukuran Huruf Mushaf -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔤 UKURAN HURUF MUSHAF ARAB"
            android:textColor="@color/emerald"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_font_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14152B"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_size_sedang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sedang (22sp)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_size_besar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Besar (26sp · Standar)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_size_xbesar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ekstra Besar (32sp)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_size_jumbo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jumbo (38sp)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />
        </RadioGroup>

        <!-- Section 4: Tampilan Ayat Pada Surah -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 TAMPILAN AYAT PADA SURAH"
            android:textColor="@color/cyan_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_tampilan_ayat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14152B"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_tampilan_lengkap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Arab + Terjemah (Lengkap)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_tampilan_arab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Arab Saja (Tanpa Terjemah)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />
        </RadioGroup>

        <!-- Section 5: Mode Contoh Mengetik Tulis -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✍️ CONTOH TEKS PADA MENGETIK TULIS"
            android:textColor="@color/emerald"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_contoh_tulis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14152B"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_tulis_dengan_contoh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dengan Contoh (Tampilkan teks acuan ayat)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_tulis_tanpa_contoh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tanpa Contoh (Sembunyikan teks Arab · Ketik dari ingatan)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />
        </RadioGroup>

        <!-- Section 4: Mode Contoh Setoran Hafalan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 CONTOH TEKS PADA SETORAN HAFALAN"
            android:textColor="@color/purple_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_contoh_hafalan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14152B"
            android:padding="8dp"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rb_hafal_dengan_contoh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dengan Contoh (Tampilkan teks Arab)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />

            <RadioButton
                android:id="@+id/rb_hafal_tanpa_contoh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tanpa Contoh (Sembunyikan teks Arab · Uji hafalan)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/gold_primary" />
        </RadioGroup>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cancel_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_action"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Batal"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btn_save_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_number"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Simpan"
                android:textColor="@color/gold_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
