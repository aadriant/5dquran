<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card_surah"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- Title & Version -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5D Quran"
                android:textColor="@color/gold_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Versi 1.0.2 · Pure Native Android"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 Dimensi Interaksi dengan Al-Qur\'an"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 5D Summary -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161830"
            android:padding="14dp"
            android:lineSpacingMultiplier="1.3"
            android:text="📖 Dibaca — Mushaf Al-Quran lengkap 114 Surah offline\n🎧 Didengar — Murottal qari internasional per ayat &amp; surah\n🧠 Dihafal — Setoran hafalan suara native dengan koreksi kata\n✍️ Ditulis — Mengetik ayat dengan keyboard bahasa Arab &amp; koreksi kata\n📚 Dipelajari — Tafsir Ibnu Katsir dan Hadis Terkait"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <!-- Data Sources Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡 SUMBER DATA &amp; REFERENSI:"
            android:textColor="@color/gold_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:text="• AlQuran.cloud API — Teks Al-Quran Uthmani &amp; Metadata\n• EveryAyah.com &amp; QuranicAudio — Database audio murottal para qari\n• Tafsirq.com &amp; e-Quran — Tafsir Ibnu Katsir (Bahasa Indonesia)\n• Kementerian Agama RI — Terjemahan Al-Quran Bahasa Indonesia"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginBottom="16dp" />

        <!-- Prayer / Doa Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B1E38"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
                android:textColor="@color/gold_light"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:text="🤲 Mohon doa dan istighfar untuk Ari Adrianto dan keluarga, semoga istiqomah."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🌿 Semoga aplikasi ini menjadi amal jariyah yang terus mengalir."
                android:textColor="@color/emerald"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Close Button -->
        <TextView
            android:id="@+id/btn_close_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_number"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="Tutup"
            android:textColor="@color/gold_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
