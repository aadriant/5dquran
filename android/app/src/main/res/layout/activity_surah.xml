<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Content Column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_above="@id/bottom_player_bar">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:background="@color/bg_main">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Kembali" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tv_title_surah"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Al-Fatihah"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_subtitle_surah"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7 Ayat · Makkiyah"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Toggle View Mode: Card (Per Ayat) vs Page (Mushaf) -->
            <ImageButton
                android:id="@+id/btn_toggle_view_mode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_view_page"
                android:contentDescription="Ganti Mode Tampilan"
                android:layout_marginEnd="4dp" />

            <!-- Quick Action 5D Buttons in Header -->
            <ImageButton
                android:id="@+id/btn_surah_audio"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play_arrow"
                android:contentDescription="Putar Surah" />
        </LinearLayout>

        <!-- Surah Bismillah Banner (Card View) -->
        <LinearLayout
            android:id="@+id/card_bismillah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="6dp"
            android:background="@drawable/bg_card_surah"
            android:gravity="right"
            android:layoutDirection="rtl"
            android:paddingVertical="14dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tv_bismillah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:layoutDirection="rtl"
                android:textDirection="rtl"
                android:textAlignment="textStart"
                android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
                android:textColor="@color/gold_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mode 1: Ayahs Card RecyclerView (Per Ayat) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ayahs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:visibility="visible" />

        <!-- Mode 2: Mushaf Pages RecyclerView (Mushaf Page View seperti Gambar Referensi) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Page View: Quick Ayah Action Strip (when an ayah is tapped in View Page) -->
    <LinearLayout
        android:id="@+id/layout_page_action_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_player_bar"
        android:background="#161830"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_sheet_ayah_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_number"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Ayat 1"
                android:textColor="@color/gold_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sheet_indo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Dengan nama Allah Yang Maha Pengasih..."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btn_sheet_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="Tutup" />
        </LinearLayout>

        <!-- 5D Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_sheet_dengar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_action"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="🎧 Dengar"
                android:textColor="@color/cyan_accent"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_sheet_kosakata"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_action"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="📖 Kosakata"
                android:textColor="@color/gold_light"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_sheet_hafal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_action"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="🧠 Hafal"
                android:textColor="@color/purple_accent"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_sheet_tulis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_action"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="✍️ Tulis"
                android:textColor="@color/emerald"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_sheet_tafsir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_action"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="📚 Tafsir"
                android:textColor="@color/gold_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Compact Hafalan Footer in View Page (Requirement 3: tombol record di footer & diperkecil) -->
    <LinearLayout
        android:id="@+id/layout_page_hafalan_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#121326"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:elevation="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Target Ayah Badge & Live Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_footer_hafal_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_number"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="🧠 Ayat 1"
                        android:textColor="@color/purple_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tv_footer_hafal_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Siap"
                        android:textColor="@color/emerald"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_footer_hafal_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ketuk mic untuk rekam (bisa jeda nafas)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Compact Record Mic Button (Diperkecil agar tidak mengganggu) -->
            <ImageButton
                android:id="@+id/btn_footer_hafal_mic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_badge_number"
                android:src="@drawable/ic_mic"
                android:contentDescription="Rekam Hafalan"
                android:layout_marginHorizontal="6dp" />

            <!-- Listen Audio Example -->
            <ImageButton
                android:id="@+id/btn_footer_hafal_play"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play_arrow"
                android:contentDescription="Dengar Contoh"
                android:layout_marginEnd="2dp" />

            <!-- Toggle Hide/Show Text on Page -->
            <TextView
                android:id="@+id/btn_footer_hafal_eye"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_action"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:text="👁️ Tutup"
                android:textColor="@color/gold_light"
                android:textSize="10sp"
                android:layout_marginEnd="4dp" />

            <!-- Done / Evaluate Button -->
            <TextView
                android:id="@+id/btn_footer_hafal_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_action"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="✓ Nilai"
                android:textColor="@color/emerald"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <!-- Close Hafalan Mode -->
            <ImageButton
                android:id="@+id/btn_footer_hafal_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="Tutup Hafalan" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Sticky Mini Audio Player -->
    <LinearLayout
        android:id="@+id/bottom_player_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#101124"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_player_toggle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_badge_number"
                android:src="@drawable/ic_play_arrow"
                android:contentDescription="Putar / Jeda" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_player_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Murottal: Mishari Rashid Alafasy"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="right"
                    android:layoutDirection="rtl"
                    android:textDirection="rtl"
                    android:textAlignment="textStart"
                    android:text="Pilih ayat untuk memutar suara per ayat"
                    android:textColor="@color/cyan_accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_player_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_action"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Stop"
                android:textColor="@color/red_error"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
